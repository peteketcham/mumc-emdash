---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import { byWeight, imageSrc, imageAlt } from "../utils/media";
import { isCurrent } from "../utils/cards";
import { site } from "../site";

const { entries: slides } = await getEmDashCollection("slider");
const { entries: all } = await getEmDashCollection("homepage_cards", { limit: 500 });
const cards = byWeight(all.filter((c: any) => isCurrent(c)));
---
<Base title={site.name} isHome={true}>
	<div class="inner">
		<div class="block_slider_type_1">
			<div id="homepage-slider" class="swiper">
				<div class="swiper-wrapper">
					{byWeight(slides).map((s: any) => (
						<div class="swiper-slide"><img src={imageSrc(s.data.image)} alt={imageAlt(s.data.image, s.data.title)} width="950" height="438" /></div>
					))}
				</div>
				<div class="swiper-button-prev"></div>
				<div class="swiper-button-next"></div>
			</div>
		</div>
		<div class="block_general_title_1 w_margin_1">
			<h1>{site.name}</h1>
			<p class="church-address"><a href={site.mapUrl} target="_blank" rel="noopener">{site.address}</a></p>
			<p class="church-contact">&bull; {site.phone} &bull; <a href={`mailto:${site.email}`}>{site.email}</a></p>
		</div>
		<div class="block_posts type_1 type_sort">
			<div class="posts">{cards.map((c: any) => <Card card={c} />)}</div>
		</div>
	</div>
</Base>
