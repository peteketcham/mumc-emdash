---
import { PortableText } from "emdash/ui";
import { imageSrc } from "../../utils/media";
import { site } from "../../site";
/** Port of Hugo contact.html */
const { page } = Astro.props;
const d = page.data;
const staffPhoto = imageSrc(d.staff_photo);
const contacts = d.staff_contacts ?? [];
const hasContent = Array.isArray(d.content) && d.content.length > 0;
---
<div class="inner">
	<div class="block_general_title_1 w_margin_1">
		<h1>{d.title}</h1>
		{d.subtitle && <h2>{d.subtitle}</h2>}
	</div>
	<div class="contact-page-layout">
		<div class="contact-info">
			<h2>Contact Information</h2>
			<address>
				<p><strong>{site.name}</strong><br />{site.address}</p>
				<p><a href={`tel:${site.phone.replace(/[^0-9]/g, "")}`}>{site.phone}</a></p>
				<p><a href={`mailto:${site.email}`}>{site.email}</a></p>
			</address>
			{d.office_hours && (<><h3>Office Hours</h3><p set:html={d.office_hours} /></>)}
			{contacts.length > 0 && (
				<>
					<h3>Our Staff</h3>
					{staffPhoto && (
						<div class="staff-photo-preview">
							<a href="/staff/"><img src={staffPhoto} alt="Minnehaha UMC Staff" /></a>
							<p><a href="/staff/">Learn more about our staff →</a></p>
						</div>
					)}
					<ul class="staff-contact-list">
						{contacts.map((c: any) => (
							<li>
								<strong>{c.name}</strong>{c.role && <>, {c.role}</>}<br />
								{c.email && <a href={`mailto:${c.email}`}>{c.email}</a>}
							</li>
						))}
					</ul>
				</>
			)}
		</div>
		<div class="contact-form-section">
			<h2>Send Us a Message</h2>
			<p>If you have a question or would like some information about Minnehaha United Methodist Church, just fill out the form and click the "Send Message" button.</p>
			<form action={`https://formspree.io/f/${site.formspreeId}`} method="POST" class="contact-form" id="contact_form">
				<div class="form-group"><label for="name">Name <span class="required">*</span></label><input type="text" id="name" name="name" required /></div>
				<div class="form-group"><label for="email">Email <span class="required">*</span></label><input type="email" id="email" name="email" required /></div>
				<div class="form-group"><label for="subject">Subject</label><input type="text" id="subject" name="subject" /></div>
				<div class="form-group"><label for="message">Message <span class="required">*</span></label><textarea id="message" name="message" rows="6" required></textarea></div>
				<div class="form-group"><button type="submit" class="general_button_type_3">Send Message</button></div>
			</form>
		</div>
	</div>
	{hasContent && <div class="block_content page-content"><PortableText value={d.content} /></div>}
</div>
