---
import { PortableText } from "emdash/ui";
import { imageSrc } from "../../utils/media";
/** Port of Hugo slideshow.html (history page). */
const { page } = Astro.props;
const d = page.data;
const slides = d.slides ?? [];
const hasContent = Array.isArray(d.content) && d.content.length > 0;
---
<div class="inner">
	<div class="block_general_title_1 w_margin_1">
		<h1>{d.title}</h1>
		{d.subtitle && <h2>{d.subtitle}</h2>}
	</div>
	{slides.length > 0 && (
		<>
			<div class="block_slider_type_1 history-slideshow">
				<div id="history-slider" class="swiper">
					<div class="swiper-wrapper">
						{slides.map((s: any) => (
							<div class="swiper-slide"><img src={imageSrc(s.image)} alt={s.alt || (typeof s.image === "object" ? s.image?.alt : "") || ""} /></div>
						))}
					</div>
				</div>
				<div class="slideshow-controls">
					<div class="swiper-button-prev"></div>
					<div class="swiper-pagination"></div>
					<div class="swiper-button-next"></div>
				</div>
			</div>
			<script is:inline>
				document.addEventListener("DOMContentLoaded", function () {
					new Swiper("#history-slider", {
						loop: false, autoplay: false,
						navigation: { nextEl: ".swiper-button-next", prevEl: ".swiper-button-prev" },
						pagination: { el: ".swiper-pagination", type: "fraction" },
						keyboard: { enabled: true },
					});
				});
			</script>
		</>
	)}
	{hasContent && <div class="block_content page-content"><PortableText value={d.content} /></div>}
</div>
